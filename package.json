{
  "name": "split-ledger",
  "version": "0.0.0",
  "description": "Track shared group expenses and calculate who owes whom, with as few transfers as possible.",
  "keywords": [
    "expenses",
    "split",
    "bill-splitting",
    "debt-settlement",
    "money"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:match": "vitest run -t",
    "lint": "eslint ./src ./test --cache",
    "lint:fix": "eslint ./src ./test --cache --fix",
    "format": "prettier --write ./src ./test",
    "format:check": "prettier ./src ./test --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edvinkaradzas/split-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/edvinkaradzas/split-ledger/issues"
  },
  "homepage": "https://github.com/edvinkaradzas/split-ledger#readme",
  "author": "Edvin Karadza",
  "contributors": [
    "1dv610 Organization"
  ],
  "license": "Unlicense",
  "private": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lnu/eslint-config": "^2.0.13",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.3.10",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
